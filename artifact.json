        "query": "validate_analysis.py; reconcile row counts, identifiers, nonnegative metrics, and YouTube Overview totals",
        "sql": "SELECT source, grain, rows, date_start, date_end, duplicate_keys, missing_headline_metrics, quality_note FROM normalized_data_quality",
        "description": "Independent QA profile covering all three input exports; 18 of 18 validation checks passed.",
        "executed_at": "2026-08-28T23:00:00Z",
