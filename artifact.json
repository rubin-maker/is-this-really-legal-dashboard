  "sources": [
    {
      "id": "apple_csv",
      "label": "Apple Podcasts episode export",
      "path": "apple podcast.csv",
      "query": {
        "engine": "python",
        "language": "python",
        "query": "pd.read_csv('apple podcast.csv'); derive 7-day maturity, engaged_listener_rate, plays_per_listener, and episode aggregates",
        "sql": "SELECT release_date, episode, days_live, maturity, unique_listeners, engaged_listeners, engaged_rate, plays, plays_per_listener, average_consumption_pct FROM normalized_apple_episode_performance",
        "description": "Episode-level Apple Podcasts metrics normalized and ranked using a seven-day maturity rule.",
        "executed_at": "2026-08-28T23:00:00Z",
        "tables_used": [
          "apple podcast.csv"
        ],
        "metric_definitions": [
          "Mature episode: at least 7 days since release as of 2026-08-28.",
          "Engaged-listener rate = unique engaged listeners / unique listeners across mature episodes.",
          "Average consumption is listener-weighted across mature episodes and may exceed 100% with replay behavior."
        ]
      }
    },
    {
      "id": "instagram_csv",
      "label": "Instagram post export",
      "path": "instagram is this really legal.csv",
      "query": {
        "engine": "python",
        "language": "python",
        "query": "pd.read_csv('instagram is this really legal.csv'); engagements = likes + shares + comments + saves; group mature posts by publish week",
        "sql": "SELECT publish_date, description, post_type, url, days_live, maturity, views, reach, engagements, follows, engagement_rate_views FROM normalized_instagram_post_performance",
        "description": "Post-level lifetime metrics normalized with a seven-day maturity rule for rankings and weekly publish cohorts.",
        "executed_at": "2026-08-28T23:00:00Z",
        "tables_used": [
          "instagram is this really legal.csv"
        ],
        "metric_definitions": [
          "Engagements = likes + shares + comments + saves.",
          "View-based engagement rate = engagements / views.",
          "Weekly views are lifetime post totals grouped by publish week, not activity earned during that week."
        ]
      }
    },
    {
      "id": "youtube_xlsx",
      "label": "YouTube performance workbook",
      "path": "liz_oyer_youtube_performance_2026.xlsx",
      "query": {
        "engine": "python",
        "language": "python",
        "query": "pd.read_excel('liz_oyer_youtube_performance_2026.xlsx', sheet_name=['Long Data','Shorts Data']); exclude missing-view rows from measured rankings",
        "sql": "SELECT publish_date, title, product, content_id, days_live, maturity, views, watch_hours, engagements, subscribers_gained, average_pct_viewed, impressions_ctr_pct FROM normalized_youtube_video_performance",
        "description": "Individual YouTube video rows through 2026-08-28, separated into Long-Form and Shorts without aggregate Total rows.",
        "executed_at": "2026-08-28T23:00:00Z",
        "tables_used": [
          "Long Data",
          "Shorts Data",
          "Overview",
          "Definitions"
        ],
        "metric_definitions": [
          "Measured video: an individual video row with a non-null Views value.",
          "Weekly views are current cumulative video totals grouped by publish week.",
          "Long-Form and Shorts are separated; aggregate Total rows are excluded."
        ]
      }
    },
    {
      "id": "quality_qa",
      "label": "Three-source data quality profile",
      "path": "work/itrl_analysis/validation.json",
      "query": {
        "engine": "python",
